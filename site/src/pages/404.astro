---
// Built as /404.html. CloudFront will map S3 403/404 errors to it (see infra/README.md).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist." noindex>
  <main id="main" class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>The page you were looking for doesn't exist or has moved.</p>
    <p><a href="/">Back to the home page</a></p>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    align-content: center;
    gap: var(--space-3);
    min-height: 100vh;
    max-width: var(--prose-width);
    margin-inline: auto;
    padding: var(--space-5) var(--space-4);
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-accent);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  p:not(.code) {
    color: var(--color-muted);
  }
</style>
