---
// One static page per visible case study, at /case-studies/<file-name>/.
// getStaticPaths runs at build time; drafts are excluded in production, so no page
// is generated for them.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tags from '../../components/Tags.astro';
import { getVisibleCaseStudies } from '../../lib/content';
import { site } from '../../site.config';

export const getStaticPaths = (async () => {
  const entries = await getVisibleCaseStudies();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} ogType="article">
  <div class="page">
    <nav aria-label="Breadcrumb">
      <a href="/#case-studies">← {site.name}</a>
    </nav>
    <main id="main" tabindex="-1">
      <article class="prose">
        <header>
          <p class="eyebrow">Case study{entry.data.draft && ' · Draft'}</p>
          <h1>{entry.data.title}</h1>
          <p class="summary">{entry.data.summary}</p>
          <Tags items={entry.data.tags} label="Topics" />
        </header>
        <Content />
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--prose-width);
    margin-inline: auto;
    padding: var(--space-5) var(--space-4) var(--space-6);
  }

  nav a {
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  main:focus {
    outline: none;
  }

  header {
    margin-block: var(--space-5) var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  h1 {
    margin-top: var(--space-2);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .summary {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
</style>
