---
import { skills } from '../data/skills';
import Section from './Section.astro';
import Tags from './Tags.astro';
---

<Section id="skills" title="Skills">
  <dl class="skills">
    {
      skills.map(({ category, items }) => (
        <div>
          <dt>{category}</dt>
          <dd>
            <Tags items={items} label={category} />
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .skills {
    display: grid;
    gap: var(--space-4);
  }

  /* Same 1fr/3fr grid as Experience, so labels and content line up across sections. */
  @media (min-width: 40rem) {
    .skills > div {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: var(--space-3);
    }
  }

  dt {
    padding-top: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  dd {
    margin: 0;
  }

  /* Tags.astro adds a top margin meant for cards; remove it here. */
  dd :global(.tags) {
    margin-top: var(--space-2);
  }

  @media (min-width: 40rem) {
    dd :global(.tags) {
      margin-top: 0;
    }
  }
</style>
