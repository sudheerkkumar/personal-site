---
// Wrapper for a home page section: gives it an id (nav anchor target) and
// labels it with its heading for screen readers.
// On wide screens the heading is visually hidden: the sticky nav already names each
// section, and hiding it lets the first section line up with the name in the header.
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{title}</h2>
  <slot />
</section>

<style>
  section {
    margin-bottom: var(--space-6);
    scroll-margin-top: var(--space-5);
  }

  h2 {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  @media (min-width: 64rem) {
    section {
      margin-bottom: 6rem;
      scroll-margin-top: 6rem;
    }

    /* Same technique as the global .visually-hidden utility. */
    h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
