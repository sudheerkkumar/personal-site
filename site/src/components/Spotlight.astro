---
// A soft glow that follows the mouse, drawn behind all content.
// Only enabled for precise pointers (mouse/trackpad, not touch) and when the visitor
// hasn't asked for reduced motion. The position is updated at most once per frame.
---

<div class="spotlight" id="spotlight" aria-hidden="true"></div>

<script is:inline>
  (() => {
    if (!matchMedia('(pointer: fine)').matches) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const spotlight = document.getElementById('spotlight');
    let frame = 0;
    addEventListener(
      'pointermove',
      (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          spotlight.style.setProperty('--x', `${event.clientX}px`);
          spotlight.style.setProperty('--y', `${event.clientY}px`);
          spotlight.classList.add('on');
        });
      },
      { passive: true },
    );
  })();
</script>

<style>
  .spotlight {
    position: fixed;
    inset: 0;
    /* Behind the page content but above the page background. */
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(600px circle at var(--x, 50%) var(--y, 50%), var(--color-spotlight), transparent 80%);
    transition: opacity 300ms ease;
  }

  .spotlight.on {
    opacity: 1;
  }
</style>
