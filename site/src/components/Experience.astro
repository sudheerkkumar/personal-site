---
import { render } from 'astro:content';
import { getExperience } from '../lib/content';
import Section from './Section.astro';
import Tags from './Tags.astro';

const entries = await getExperience();
// render() turns each entry's Markdown body into a component we can place in the page.
const items = await Promise.all(
  entries.map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
);
---

<Section id="experience" title="Experience">
  <ol class="timeline">
    {
      items.map(({ data, Content }) => (
        <li>
          <p class="period">{data.period}</p>
          <div>
            <h3>
              {data.role} ·{' '}
              {data.companyUrl ? (
                <a href={data.companyUrl}>
                  {data.company}
                  <span aria-hidden="true"> ↗</span>
                </a>
              ) : (
                data.company
              )}
            </h3>
            <div class="summary">
              <Content />
            </div>
            <Tags items={data.tags} />
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  /* Date in a narrow label column on wider screens, above the role on mobile.
     Skills uses the same 1fr/3fr grid so both sections share one left edge. */
  @media (min-width: 40rem) {
    li {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: var(--space-3);
    }
  }

  .period {
    margin-bottom: var(--space-1);
    padding-top: 0.15rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.4;
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h3 a:hover,
  h3 a:focus-visible {
    color: var(--color-accent);
  }

  .summary {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
