---
import { render } from 'astro:content';
import { getExperience } from '../lib/content';
import Section from './Section.astro';
import Tags from './Tags.astro';

const entries = await getExperience();
// render() turns each entry's Markdown body into a component we can place in the page.
const items = await Promise.all(
  entries.map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
);
---

<Section id="experience" title="Experience">
  <ol class="timeline">
    {
      items.map(({ data, Content }) => (
        <li class="entry">
          <p class="period">{data.period}</p>
          <div>
            <h3>
              {data.role} ·{' '}
              {data.companyUrl ? (
                <a href={data.companyUrl}>
                  {data.company}
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                data.company
              )}
            </h3>
            <div class="summary">
              <Content />
            </div>
            <Tags items={data.tags} />
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  /*
    Each entry is one click target. The company link is the only real link; its ::after
    is stretched over the whole entry, so screen readers announce a single link (the
    role/company heading) instead of the entire paragraph.
  */
  .entry {
    position: relative;
    /* Keeps the hover background (z-index: -1 below) inside this entry. */
    isolation: isolate;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--space-3)) calc(-1 * var(--space-4));
    border-radius: var(--radius);
  }

  /* The hover/focus card, drawn slightly outside the text so alignment doesn't shift. */
  .entry::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(-1 * var(--space-3)) calc(-1 * var(--space-4));
    border-radius: var(--radius);
    transition: background-color 150ms ease;
  }

  .entry:hover::before {
    background: var(--color-surface);
    box-shadow: inset 0 1px 0 0 rgb(148 163 184 / 0.1);
  }

  .entry:hover h3,
  .entry:hover h3 a,
  .entry:has(h3 a:focus-visible) h3,
  h3 a:focus-visible {
    color: var(--color-accent);
  }

  .arrow {
    display: inline-block;
    margin-left: 0.15rem;
    transition: transform 150ms ease;
  }

  .entry:hover .arrow,
  h3 a:focus-visible .arrow {
    transform: translate(2px, -2px);
  }

  /* Keyboard focus outlines the whole entry rather than just the company name. */
  h3 a:focus-visible {
    outline: none;
  }

  h3 a:focus-visible::after {
    outline: 2px solid var(--color-accent);
  }

  /* While one entry is hovered, fade the others (mouse users on wide screens only). */
  @media (hover: hover) and (min-width: 64rem) {
    .timeline:has(> .entry:hover) > .entry:not(:hover) {
      opacity: 0.5;
    }

    .entry {
      transition: opacity 150ms ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .entry::before,
    .arrow {
      transition: none;
    }
  }

  /* Date in a narrow label column on wider screens, above the role on mobile.
     Skills uses the same 1fr/3fr grid so both sections share one left edge. */
  @media (min-width: 40rem) {
    li {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: var(--space-3);
    }
  }

  .period {
    margin-bottom: var(--space-1);
    padding-top: 0.15rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.4;
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .summary {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
