---
// Page header: name, title, positioning statement, location, section nav, links.
// On wide screens this column stays fixed (sticky) while the content scrolls.
import { Image } from 'astro:assets';
import { site } from '../site.config';
import profilePhoto from '../assets/profile.jpg';
import Icon from './Icon.astro';
import SectionNav from './SectionNav.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;

const links = [
  { label: 'LinkedIn', href: site.links.linkedin, icon: 'linkedin', rel: 'me noopener' },
  { label: 'GitHub', href: site.links.github, icon: 'github', rel: 'me noopener' },
  { label: 'Email', href: `mailto:${site.email}`, icon: 'mail' },
  { label: 'CV (PDF)', href: site.links.cv, icon: 'file' },
] as const;
---

<header class="hero">
  <div>
    <!--
      Astro's <Image> resizes the photo at build time (via sharp, bundled with Astro),
      converts it to WebP and emits 1x/2x versions. Eager-loaded: it is above the fold.
    -->
    <Image
      src={profilePhoto}
      alt={`Portrait of ${site.name}`}
      width={128}
      height={128}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
    <h1>{site.name}</h1>
    <p class="title">{site.title}</p>
    <p class="tagline">{site.tagline}</p>
    <p class="location">{site.location}</p>
    <SectionNav sections={sections} />
  </div>

  <div class="footer-row">
    <ul class="links" aria-label="Profiles and contact">
      {
        links.map((link) => (
          <li>
            {/* Icon only visually; the hidden label is what screen readers announce,
                and `title` gives mouse users a tooltip. */}
            <a href={link.href} rel={'rel' in link ? link.rel : undefined} title={link.label}>
              <Icon name={link.icon} />
              <span class="visually-hidden">{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
  }

  @media (min-width: 64rem) {
    .hero {
      /* Don't stretch to the height of the content column (the grid default). */
      align-self: start;
      padding-block: 5rem var(--space-4);
    }
  }

  /* Sticky full-height column only when the window is tall enough to show all of it;
     otherwise the bottom links would be cut off and unreachable. Shorter windows get a
     normally scrolling column instead. */
  @media (min-width: 64rem) and (min-height: 48rem) {
    .hero {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }

  .photo {
    width: 6rem;
    height: 6rem;
    margin-bottom: var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: 50%;
  }

  @media (min-width: 64rem) {
    .photo {
      width: 7rem;
      height: 7rem;
    }
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.025em;
  }

  /* In the two-column layout, scale the name with the window so the full name stays
     on one line; a wrapped name would make the sticky column taller than the screen. */
  @media (min-width: 64rem) {
    h1 {
      font-size: clamp(2rem, 3.2vw, 3rem);
      white-space: nowrap;
    }
  }

  .title {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.4;
  }

  .tagline {
    max-width: 22rem;
    margin-top: var(--space-3);
    color: var(--color-muted);
  }

  .location {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .links a {
    /* 40px square: a comfortable tap target around a 22px icon. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-muted);
    transition: color 150ms ease;
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--color-accent);
  }
</style>
