---
// Page header: name, title, positioning statement, location, section nav, links.
// On wide screens this column stays fixed (sticky) while the content scrolls.
import { Image } from 'astro:assets';
import { site } from '../site.config';
import profilePhoto from '../assets/profile.jpg';
import SectionNav from './SectionNav.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<header class="hero">
  <div>
    <!--
      Astro's <Image> resizes the photo at build time (via sharp, bundled with Astro),
      converts it to WebP and emits 1x/2x versions. Eager-loaded: it is above the fold.
    -->
    <Image
      src={profilePhoto}
      alt={`Portrait of ${site.name}`}
      width={128}
      height={128}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
    <h1>{site.name}</h1>
    <p class="title">{site.title}</p>
    <p class="tagline">{site.tagline}</p>
    <p class="location">{site.location}</p>
    <SectionNav sections={sections} />
  </div>

  <div class="footer-row">
    <ul class="links" aria-label="Profiles and contact">
      <li><a href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={site.links.github} rel="me noopener">GitHub</a></li>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.links.cv}>CV <span class="visually-hidden">(PDF)</span></a></li>
    </ul>
    <ThemeToggle />
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
  }

  @media (min-width: 64rem) {
    .hero {
      /* Don't stretch to the height of the content column (the grid default). */
      align-self: start;
      padding-block: 5rem var(--space-4);
    }
  }

  /* Sticky full-height column only when the window is tall enough to show all of it;
     otherwise the bottom links would be cut off and unreachable. Shorter windows get a
     normally scrolling column instead. */
  @media (min-width: 64rem) and (min-height: 48rem) {
    .hero {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }

  .photo {
    width: 6rem;
    height: 6rem;
    margin-bottom: var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: 50%;
  }

  @media (min-width: 64rem) {
    .photo {
      width: 7rem;
      height: 7rem;
    }
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.025em;
  }

  .title {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.4;
  }

  .tagline {
    max-width: 22rem;
    margin-top: var(--space-3);
    color: var(--color-muted);
  }

  .location {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .links a {
    /* Comfortable tap target on mobile (at least 24px tall). */
    display: inline-block;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-muted);
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--color-accent);
  }
</style>
