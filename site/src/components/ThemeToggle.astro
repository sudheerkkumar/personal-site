---
// Light/dark toggle. Rendered `hidden` and revealed by the script, so visitors
// without JavaScript never see a button that does nothing.
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" hidden>
  <span class="visually-hidden">Light theme</span>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));

    button.hidden = false;
    sync();
    button.addEventListener('click', () => {
      const light = root.dataset.theme !== 'light';
      if (light) root.dataset.theme = 'light';
      else delete root.dataset.theme;
      try {
        if (light) localStorage.setItem('theme', 'light');
        else localStorage.removeItem('theme');
      } catch {}
      sync();
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: transparent;
    color: var(--color-muted);
    border: 0;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  .theme-toggle[hidden] {
    display: none;
  }
</style>
