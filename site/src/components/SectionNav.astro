---
// In-page navigation to the home page sections. Shown on wide screens only;
// on mobile the page is a single readable column, so the list would only add noise.
interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<nav aria-label="Sections" class="section-nav">
  <ul>
    {
      sections.map(({ id, label }) => (
        <li>
          <a href={`#${id}`}>{label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .section-nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .section-nav {
      display: block;
      margin-top: var(--space-4);
    }
  }

  ul {
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-muted);
  }

  /* Short line before each item that extends on hover/focus. */
  a::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: currentColor;
    transition: width 150ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text);
  }

  a:hover::before,
  a:focus-visible::before {
    width: 4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    a::before {
      transition: none;
    }
  }
</style>
